{
  "openapi": "3.0.2",
  "info": {
    "title": "ESS-DIVE anyOf regression excerpt",
    "version": "production snapshot 2026-09-21"
  },
  "components": {
    "schemas": {
      "Dataset": {
        "title": "Dataset",
        "required": [
          "description",
          "creator"
        ],
        "type": "object",
        "properties": {
          "description": {
            "title": "Description",
            "anyOf": [
              {
                "maxLength": 5000,
                "minLength": 1,
                "type": "string"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "maxLength": 5000,
                  "minLength": 1,
                  "type": "string"
                }
              }
            ],
            "description": "(Abstract) A concise description of the purpose and content of this data package."
          },
          "creator": {
            "title": "Creator",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Person"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            ],
            "description": "(Creator/Author) The main researchers involved in producing the data."
          },
          "keywords": {
            "title": "Keywords",
            "anyOf": [
              {
                "maxLength": 175,
                "minLength": 1,
                "type": "string"
              },
              {
                "minItems": 1,
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "maxLength": 175,
                  "minLength": 1,
                  "type": "string"
                }
              }
            ],
            "description": "Keywords that should be associated with this data package to enable thematic searches."
          },
          "sameAs": {
            "title": "SameAs",
            "anyOf": [
              {
                "maxLength": 2083,
                "minLength": 1,
                "pattern": "^http[s]?://(dx.|)doi.org/",
                "type": "string",
                "format": "uri"
              },
              {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "maxLength": 2083,
                  "minLength": 1,
                  "pattern": "^http[s]?://(dx.|)doi.org/",
                  "type": "string",
                  "format": "uri"
                }
              }
            ],
            "description": "DOI URL of a reference Web page that unambiguously indicates the item's identity."
          },
          "spatialCoverage": {
            "title": "SpatialCoverage",
            "anyOf": [
              {
                "$ref": "#/components/schemas/Place"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Place"
                }
              }
            ],
            "description": "(Location) Add one or more places with at least one GeoCoordinate and no more than two."
          }
        },
        "additionalProperties": false,
        "description": "Main JSON-LD data model for an ESS-DIVE Dataset."
      },
      "Person": {
        "title": "Person",
        "required": [
          "familyName"
        ],
        "type": "object",
        "properties": {
          "familyName": {
            "title": "Familyname",
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          }
        },
        "description": "A Person. Subset of https://schema.org/Person"
      },
      "Place": {
        "title": "Place",
        "required": [
          "geo"
        ],
        "type": "object",
        "properties": {
          "geo": {
            "title": "Geo",
            "anyOf": [
              {
                "$ref": "#/components/schemas/GeoCoordinates"
              },
              {
                "maxItems": 2,
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/GeoCoordinates"
                }
              }
            ],
            "description": "Accepted names are 'Northwest and Southeast."
          }
        },
        "additionalProperties": false,
        "description": "Entities that have a somewhat fixed, physical extension."
      },
      "GeoCoordinates": {
        "title": "GeoCoordinates",
        "required": [
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "latitude": {
            "title": "Latitude",
            "maximum": 90.0,
            "minimum": -90.0,
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "maximum": 180.0,
            "minimum": -180.0,
            "type": "number"
          }
        },
        "description": "The geographic coordinates of a place or event."
      }
    }
  }
}
